# Copy to .env and fill in.

# PostgreSQL / PostGIS
DATABASE_URL=postgresql+psycopg2://signalsafe:signalsafe@localhost:5432/signalsafe

# OpenCelliD API token (free: register at https://www.opencellid.org -> account -> API token)
OPENCELLID_TOKEN=your_token_here

# Mobile country codes to load (India = 404,405)
OCID_MCC_LIST=404,405

# External services (defaults are public demo endpoints; self-host for production)
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# API
API_HOST=0.0.0.0
API_PORT=8000
